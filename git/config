[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    syntax-theme = ansi
    minus-style = red
    minus-emph-style = red reverse
    plus-style = green
    plus-emph-style = green reverse
[merge]
    conflictStyle = zdiff3
