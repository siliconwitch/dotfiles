# This repo is cloned as ~/.config, so ignore everything by default and
# explicitly allow only the files we track.
/*
!/.gitignore
!/README.md
!/CLAUDE.md
!/flake.nix
!/flake.lock
!/configuration.nix
!/hardware-configuration.nix
!/apparmor.nix
!/simsmith.nix
!/user-dirs.dirs
!/agents/
!/niri/
!/ghostty/
!/mako/
!/zsh/
!/git/
!/hypr/
!/nvim/
!/launtui/
!/yazi/
!/python_keyring/
!/herdr/
/herdr/*
!/herdr/config.toml
!/voxtype/
/voxtype/*
!/voxtype/config.toml
!/voxtype/sounds/
# OBS's scene and WebSocket files hold a screen-share token and a password, so only the profile is tracked
!/obs-studio/
/obs-studio/**
!/obs-studio/**/
!/obs-studio/basic/profiles/Untitled/basic.ini
!/wallpaper.jpg
!/screenshot.png

# Runtime junk inside tracked dirs
zsh/.zcompdump*
agents/skills/synced/
