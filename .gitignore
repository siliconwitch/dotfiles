# This repo is cloned as ~/.config, so ignore everything by default and
# explicitly allow only the files we track.
/*
!/.gitignore
!/README.md
!/CLAUDE.md
!/flake.nix
!/flake.lock
!/configuration.nix
!/hardware-configuration.nix
!/apparmor.nix
!/simsmith.nix
!/user-dirs.dirs
!/agents/
!/niri/
!/ghostty/
!/mako/
!/zsh/
!/git/
!/hypr/
!/nvim/
!/launtui/
!/yazi/
!/python_keyring/
!/herdr/
/herdr/*
!/herdr/config.toml
!/wallpaper.jpg
!/screenshot.png

# Runtime junk inside tracked dirs
zsh/.zcompdump*
agents/skills/synced/
