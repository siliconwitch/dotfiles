# This repo is cloned as ~/.config, so ignore everything by default and
# explicitly allow only the files we track.
/*
!/.gitignore
!/README.md
!/CLAUDE.md
!/flake.nix
!/flake.lock
!/configuration.nix
!/hardware-configuration.nix
!/apparmor.nix
!/webapps.nix
!/user-dirs.dirs
!/agents/
!/niri/
!/foot/
!/mako/
!/zsh/
!/git/
!/hypr/
!/helix/
!/fastfetch/
!/scripts/
!/launtui/
!/yazi/
!/python_keyring/
!/wallpaper.jpg
!/screenshot.png

# Runtime junk inside tracked dirs
zsh/.zcompdump*
