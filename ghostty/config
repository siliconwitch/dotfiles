font-family = RobotoMono Nerd Font Mono
font-family = Noto Color Emoji
font-size = 12

window-padding-x = 0
window-padding-y = 0
window-decoration = none
gtk-titlebar = false
gtk-toolbar-style = flat
confirm-close-surface = false

# Bytes, not lines.
scrollback-limit = 50000000

cursor-style = bar
cursor-color = #fbb829
cursor-text = #1c1b19

background-opacity = 0.6
background-opacity-cells = true

background = #1c1b19
foreground = #fce8c3
selection-foreground = #1c1b19
selection-background = #fce8c3

palette = 0=#1c1b19
palette = 1=#ef2f27
palette = 2=#519f50
palette = 3=#fbb829
palette = 4=#2c78bf
palette = 5=#e02c6d
palette = 6=#0aaeb3
palette = 7=#baa67f
palette = 8=#918175
palette = 9=#f75341
palette = 10=#98bc37
palette = 11=#fed06e
palette = 12=#68a8e4
palette = 13=#ff5c8f
palette = 14=#2be4d0
palette = 15=#fce8c3
