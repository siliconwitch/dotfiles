spawn-sh-at-startup "mako"
spawn-sh-at-startup "swaybg -i ~/.config/wallpaper.jpg"
spawn-sh-at-startup "foot --server"
spawn-sh-at-startup "foot herdr"

binds {
    // Launcher & shortcuts
    Mod+Space                   hotkey-overlay-title="Launcher"                     { spawn-sh "w=$(niri msg --json windows | jq -r 'map(select(.app_id == \"launcher\")) | first | .id // empty'); if [ -n \"$w\" ]; then niri msg action close-window --id \"$w\"; else footclient --app-id=launcher -o colors-dark.alpha=0.8 launtui; fi"; }
    Mod+T                       hotkey-overlay-title="Terminal"                     { spawn-sh "footclient"; }
    Mod+B                       hotkey-overlay-title="Browser"                      { spawn-sh "firefox"; }
    Mod+Y                       hotkey-overlay-title="YouTube Music"                { spawn-sh "w=$(niri msg --json windows | jq -r 'map(select(.app_id == \"com.github.th-ch.youtube-music\")) | first | .id // empty'); if [ -n \"$w\" ]; then niri msg action close-window --id \"$w\"; else pear-desktop; fi"; }
    Mod+D                       hotkey-overlay-title="Discord"                      { spawn-sh "w=$(niri msg --json windows | jq -r 'map(select(.app_id == \"vesktop\")) | first | .id // empty'); if [ -n \"$w\" ]; then niri msg action close-window --id \"$w\"; else vesktop; fi"; }
    Mod+Shift+F                 hotkey-overlay-title="Files"                        { spawn-sh "w=$(niri msg --json windows | jq -r 'map(select(.app_id == \"yazi\")) | first | .id // empty'); if [ -n \"$w\" ]; then niri msg action close-window --id \"$w\"; else footclient --app-id=yazi -o colors-dark.alpha=0.8 dtach -A \"$XDG_RUNTIME_DIR/yazi.dtach\" -E -z -r winch yazi ~; fi"; }
    Mod+Shift+M                 hotkey-overlay-title="Mixer"                        { spawn-sh "w=$(niri msg --json windows | jq -r 'map(select(.app_id == \"wiremix\")) | first | .id // empty'); if [ -n \"$w\" ]; then niri msg action close-window --id \"$w\"; else footclient --app-id=wiremix -o colors-dark.alpha=0.8 wiremix; fi"; }
    Mod+Shift+N                 hotkey-overlay-title="Network"                      { spawn-sh "w=$(niri msg --json windows | jq -r 'map(select(.app_id == \"impala\")) | first | .id // empty'); if [ -n \"$w\" ]; then niri msg action close-window --id \"$w\"; else footclient --app-id=impala -o colors-dark.alpha=0.8 impala; fi"; }
    Mod+Shift+B                 hotkey-overlay-title="Bluetooth"                    { spawn-sh "w=$(niri msg --json windows | jq -r 'map(select(.app_id == \"bluetui\")) | first | .id // empty'); if [ -n \"$w\" ]; then niri msg action close-window --id \"$w\"; else footclient --app-id=bluetui -o colors-dark.alpha=0.8 bluetui; fi"; }

    // Navigation
    Mod+H                       hotkey-overlay-title="Navigate left"                { focus-column-left; }
    Mod+J                       hotkey-overlay-title="Navigate down"                { focus-window-or-workspace-down; }
    Mod+K                       hotkey-overlay-title="Navigate up"                  { focus-window-or-workspace-up; }
    Mod+L                       hotkey-overlay-title="Navigate right"               { focus-column-right; }

    Mod+Ctrl+H                  hotkey-overlay-title="Navigate to left monitor"     { focus-monitor-left; }
    Mod+Ctrl+L                  hotkey-overlay-title="Navigate to right monitor"    { focus-monitor-right; }

    Mod+1                                                                           { focus-workspace 1; }
    Mod+2                                                                           { focus-workspace 2; }
    Mod+3                                                                           { focus-workspace 3; }

    // Window control
    Mod+Shift+H                 hotkey-overlay-title="Move window left"             { move-column-left; }
    Mod+Shift+J                 hotkey-overlay-title="Move window down"             { move-window-down-or-to-workspace-down; }
    Mod+Shift+K                 hotkey-overlay-title="Move window up"               { move-window-up-or-to-workspace-up; }
    Mod+Shift+L                 hotkey-overlay-title="Move window right"            { move-column-right; }

    Mod+Shift+Ctrl+H            hotkey-overlay-title="Move window to left monitor"  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+L            hotkey-overlay-title="Move window to right monitor" { move-column-to-monitor-right; }

    Mod+Q                       hotkey-overlay-title="Close window" repeat=false    { close-window; }

    Mod+R                       hotkey-overlay-title="Toggle width"                 { switch-preset-column-width; }
    Mod+Shift+R                 hotkey-overlay-title="Toggle width reverse"         { switch-preset-column-width-back; }
    Mod+F                       hotkey-overlay-title="Maximise screen"              { maximize-window-to-edges; }
    Mod+V                       hotkey-overlay-title="Toggle floating"              { toggle-window-floating; }
    Mod+Shift+V                 hotkey-overlay-title="Focus floating/tiled"         { switch-focus-between-floating-and-tiling; }

    // Function keys
    Mod+XF86AudioMute           hotkey-overlay-title="Cycle audio output"           { spawn-sh "SINKS=$(pactl -f json list sinks | jq -r '.[] | .active_port as $ap | select($ap == null or ([.ports[]? | select(.name == $ap and .availability == \"not available\")] | length == 0)) | .name'); [ -n \"$SINKS\" ] || exit 0; DEFAULT=$(pactl get-default-sink); NEXT=$(printf '%s\n' \"$SINKS\" | grep -Fx -A1 \"$DEFAULT\" | tail -1); { [ -z \"$NEXT\" ] || [ \"$NEXT\" = \"$DEFAULT\" ]; } && NEXT=$(printf '%s\n' \"$SINKS\" | head -1); pactl set-default-sink \"$NEXT\"; DESC=$(pactl -f json list sinks | jq -r --arg n \"$NEXT\" '.[] | select(.name == $n) | .description'); notify-send -h string:x-canonical-private-synchronous:audio-output 'Audio Output' \"$DESC\""; }
    XF86AudioRaiseVolume        allow-when-locked=true                              { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.025+ -l 1.0 && notify-send -h string:x-canonical-private-synchronous:volume -h int:value:$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf \"%d\", $2 * 100}') 'Volume' \"$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf \"%d%%\", $2 * 100}')\""; }
    XF86AudioLowerVolume        allow-when-locked=true                              { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.025- && notify-send -h string:x-canonical-private-synchronous:volume -h int:value:$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf \"%d\", $2 * 100}') 'Volume' \"$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf \"%d%%\", $2 * 100}')\""; }
    XF86AudioMute               allow-when-locked=true                              { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && notify-send -h string:x-canonical-private-synchronous:volume 'Volume' \"$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print ($3 == \"[MUTED]\") ? \"Muted\" : \"Unmuted\"}')\""; }
    XF86AudioMicMute            allow-when-locked=true                              { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay               allow-when-locked=true                              { spawn-sh "playerctl play-pause"; }
    XF86AudioPrev               allow-when-locked=true                              { spawn-sh "playerctl previous"; }
    XF86AudioNext               allow-when-locked=true                              { spawn-sh "playerctl next"; }
    XF86MonBrightnessUp         allow-when-locked=true                              { spawn-sh "brightnessctl set 10%+ && VAL=$(( $(brightnessctl get) * 100 / $(brightnessctl max-brightness) )) && notify-send -h string:x-canonical-private-synchronous:brightness -h int:value:$VAL Brightness \"$VAL%\""; }
    XF86MonBrightnessDown       allow-when-locked=true                              { spawn-sh "brightnessctl set 10%- && VAL=$(( $(brightnessctl get) * 100 / $(brightnessctl max-brightness) )) && notify-send -h string:x-canonical-private-synchronous:brightness -h int:value:$VAL Brightness \"$VAL%\""; }
    Shift+XF86MonBrightnessUp   allow-when-locked=true                              { spawn-sh "exec 9>/tmp/ext-brightness.lock; flock -n 9 || exit 0; for c in /sys/class/drm/card*-DP-* /sys/class/drm/card*-HDMI-*; do [ \"$(cat $c/status 2>/dev/null)\" = connected ] && BUS=$(basename $(readlink $c/ddc) | cut -d- -f2) && break; done; [ -n \"$BUS\" ] || exit 0; VAL=$(ddcutil --bus $BUS getvcp 10 --brief 2>/dev/null | awk '{print $4}'); VAL=$(( VAL + 10 )); [ $VAL -gt 100 ] && VAL=100; notify-send -h string:x-canonical-private-synchronous:brightness -h int:value:$VAL 'External Brightness' \"$VAL%\"; ddcutil --bus $BUS --noverify setvcp 10 $VAL"; }
    Shift+XF86MonBrightnessDown allow-when-locked=true                              { spawn-sh "exec 9>/tmp/ext-brightness.lock; flock -n 9 || exit 0; for c in /sys/class/drm/card*-DP-* /sys/class/drm/card*-HDMI-*; do [ \"$(cat $c/status 2>/dev/null)\" = connected ] && BUS=$(basename $(readlink $c/ddc) | cut -d- -f2) && break; done; [ -n \"$BUS\" ] || exit 0; VAL=$(ddcutil --bus $BUS getvcp 10 --brief 2>/dev/null | awk '{print $4}'); VAL=$(( VAL - 10 )); [ $VAL -lt 0 ] && VAL=0; notify-send -h string:x-canonical-private-synchronous:brightness -h int:value:$VAL 'External Brightness' \"$VAL%\"; ddcutil --bus $BUS --noverify setvcp 10 $VAL"; }

    // Screenshots and recording
    Mod+Shift+1                 hotkey-overlay-title="Screenshot"                   { screenshot-screen; }
    Mod+Shift+2                 hotkey-overlay-title="Screenshot window"            { screenshot-window; }
    Mod+Shift+3                 hotkey-overlay-title="Screenshot selection"         { screenshot; }
    Mod+Shift+section           hotkey-overlay-title="Recording mode"               { spawn-sh "if makoctl mode | grep -qx do-not-disturb; then makoctl mode -r do-not-disturb; for o in $(niri msg --json outputs | jq -r 'to_entries[] | select(.value.logical) | .key'); do niri msg output \"$o\" scale auto; done; pkill -x swaybg; swaybg -i ~/.config/wallpaper.jpg & else niri msg output \"$(niri msg --json focused-output | jq -r .name)\" scale 2; pkill -x swaybg; swaybg -c '#1c1b19' & makoctl mode -a do-not-disturb; fi"; }
    Mod+Shift+4                 hotkey-overlay-title="Record screen" repeat=false   { spawn-sh "notify-send Recording \"$(obs-cmd -w obsws://localhost:4455 recording toggle 2>&1)\""; }

    // Other
    Mod+XF86ScreenSaver         hotkey-overlay-title="Lock the Screen"              { spawn-sh "loginctl lock-session && sleep 2 && niri msg action power-off-monitors"; }
    Mod+Delete                  hotkey-overlay-title="Lock the Screen"              { spawn-sh "loginctl lock-session && sleep 2 && niri msg action power-off-monitors"; }
    Mod+Shift+Delete            allow-when-locked=true                              { spawn-sh "loginctl lock-session"; }
    Mod+Shift+Slash             hotkey-overlay-title=null                           { show-hotkey-overlay; }
}

input {
    disable-power-key-handling
    focus-follows-mouse max-scroll-amount="50%"

    keyboard {
        xkb {
            layout "gb(mac)"
            options "caps:none"
        }
    }

    touchpad {
        natural-scroll
        scroll-factor 0.5
    }
}

cursor {
    hide-when-typing
    hide-after-inactive-ms 5000
}

layout {
    gaps 12

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 3
        active-color "#fbb829"
    }
}

blur {
    passes 2
}

prefer-no-csd

window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
    draw-border-with-background false
}

// Undo the slow touchpad scroll-factor for terminals
window-rule {
    match app-id=r#"^(foot|footclient|launcher|wiremix|impala|bluetui|yazi)$"#
    scroll-factor 6.0
}

window-rule {
    match app-id=r#"^foot(client)?$"# is-floating=false
    background-effect {
        blur true
    }
}

// Maximise the herdr terminal opened at login
window-rule {
    match app-id=r#"^foot(client)?$"# at-startup=true
    open-maximized-to-edges true
}

window-rule {
    match app-id=r#"^(launcher|wiremix|impala|bluetui|yazi)$"#
    focus-ring {
        off
    }
    border {
        on
        width 3
        active-color "#fbb829"
        inactive-color "#fbb82950"
    }
}

// Small floating window for launcher
window-rule {
    match app-id="^launcher$"
    open-floating true
    default-column-width { fixed 700; }
    default-window-height { fixed 450; }
}

// Medium floating window for bluetui, impala and wiremix
window-rule {
    match app-id=r#"^(wiremix|impala|bluetui)$"#
    open-floating true
    default-column-width { fixed 1000; }
    default-window-height { fixed 700; }
}

// Large floating window for apps such as Discord and YouTube Music
window-rule {
    match app-id="^yazi$"
    match app-id=r#"^(vesktop|com\.github\.th-ch\.youtube-music)$"#
    open-floating true
    default-column-width { proportion 0.8; }
    default-window-height { proportion 0.8; }
}

// Floor for floating dialogs: KiCad and friends request too-small sizes on Wayland
window-rule {
    match is-floating=true
    exclude app-id="^launcher$"
    exclude title="^Picture-in-Picture$"
    min-width 640
    min-height 480
}

window-rule {
    match app-id="^firefox$" title="^Picture-in-Picture$"
    open-floating true
    default-floating-position x=12 y=12 relative-to="bottom-right"
    default-window-height { proportion 0.25; }
}

hotkey-overlay {
    skip-at-startup
    hide-not-bound
}

gestures {
    hot-corners {
        off
    }
}

animations {
    window-movement {
        spring damping-ratio=1.1 stiffness=400 epsilon=0.0001
    }

    horizontal-view-movement {
        spring damping-ratio=1.1 stiffness=400 epsilon=0.0001
    }

    // Random squares from https://github.com/liixini/shaders (MIT).
    window-open {
        duration-ms 500
        curve "ease-out-cubic"
        custom-shader r"
            float rs_rand(vec2 co) {
                return fract(sin(dot(co.xy, vec2(12.9898, 78.233))) * 43758.5453);
            }

            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                if (coords_geo.x < 0.0 || coords_geo.x > 1.0 || coords_geo.y < 0.0 || coords_geo.y > 1.0) return vec4(0.0);
                float p = niri_clamped_progress;
                vec2 uv = coords_geo.xy;
                vec3 tc = niri_geo_to_tex * vec3(uv, 1.0);
                vec4 win = texture2D(niri_tex, tc.st);

                // Fixed 75 px squares in logical pixels, whatever the window shape.
                float smoothness = 0.5;
                float r = rs_rand(floor(uv * size_geo.xy / 75.0));
                float reveal = smoothstep(0.0, -smoothness, r - (p * (1.0 + smoothness)));

                return win * reveal;
            }
        "
    }

    window-close {
        duration-ms 350
        curve "ease-out-cubic"
        custom-shader r"
            float rs_rand(vec2 co) {
                return fract(sin(dot(co.xy, vec2(12.9898, 78.233))) * 43758.5453);
            }

            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                if (coords_geo.x < 0.0 || coords_geo.x > 1.0 || coords_geo.y < 0.0 || coords_geo.y > 1.0) return vec4(0.0);
                float p = 1.0 - niri_clamped_progress;
                vec2 uv = coords_geo.xy;
                vec3 tc = niri_geo_to_tex * vec3(uv, 1.0);
                vec4 win = texture2D(niri_tex, tc.st);

                // Fixed 75 px squares in logical pixels, whatever the window shape.
                float smoothness = 0.5;
                float r = rs_rand(floor(uv * size_geo.xy / 75.0));
                float reveal = smoothstep(0.0, -smoothness, r - (p * (1.0 + smoothness)));

                return win * reveal;
            }
        "
    }

    window-resize {
        duration-ms 400
        curve "ease-out-cubic"
        custom-shader r"
            bool inside(vec3 c) {
                return 0.0 <= c.x && c.x <= 1.0 && 0.0 <= c.y && c.y <= 1.0;
            }

            vec4 resize_color(vec3 coords_curr_geo, vec3 size_curr_geo) {
                if (!inside(coords_curr_geo)) return vec4(0.0);
                vec3 next_geo = niri_curr_geo_to_next_geo * coords_curr_geo;
                vec3 prev_geo = niri_curr_geo_to_prev_geo * coords_curr_geo;
                bool next_ok = inside(next_geo);
                bool prev_ok = inside(prev_geo);
                vec4 next = next_ok ? texture2D(niri_tex_next, (niri_geo_to_tex_next * next_geo).st) : vec4(0.0);
                vec4 prev = prev_ok ? texture2D(niri_tex_prev, (niri_geo_to_tex_prev * prev_geo).st) : vec4(0.0);
                if (!prev_ok) return next;
                if (!next_ok) return prev;
                return mix(prev, next, niri_clamped_progress);
            }
        "
    }
}

screenshot-path "~/downloads/%Y%m%d-screenshot-%H:%M:%S.png"

switch-events {
    lid-close { spawn "sh" "-c" "loginctl lock-session; niri msg output eDP-1 off; [ \"$(cat /sys/class/power_supply/ADP0/online)\" = 0 ] && systemctl suspend"; }
    lid-open  { spawn "niri" "msg" "output" "eDP-1" "on"; }
}
